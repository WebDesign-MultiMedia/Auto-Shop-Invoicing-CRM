# Copy to .env.local and fill in. Never commit real values.
# See README "Deployment: production vs. demo" for which vars go where.

# --- Auth (required in every environment) ---
# openssl rand -hex 32
SESSION_SECRET=
# JSON map of login (email or 10-digit phone) -> "salt:hash" from `npm run hash-password`
# e.g. {"owner@example.com":"<salt:hash>","5550100123":"<salt:hash>"}
STAFF_ACCOUNTS=

# --- Invoice share links ---
INVOICE_SHARE_SECRET=
NEXT_PUBLIC_APP_URL=

# --- Production only (leave unset in the demo) ---
SHEETDB_API_URL=
RESEND_API_KEY=

# --- Demo only ---
# DEMO_MODE=true
# DEMO_LOGIN_HINT=Demo login: demo@example.com / <published demo password>
